{
  "name": "@sulala-ai/agent-os",
  "version": "0.1.42",
  "description": "Lightweight Bun-based Agent Operating System — micro-agents, skills, workflows",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sulala-ai/sulala.git"
  },
  "homepage": "https://github.com/Sulala-ai/sulala#readme",
  "bugs": {
    "url": "https://github.com/Sulala-ai/sulala/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "sulala": "dist/cli.js"
  },
  "scripts": {
    "build": "bun build src/cli.ts --outdir=dist --target=bun && bun build src/index.ts --outdir=dist --target=bun",
    "build:dashboard": "cd dashboard && VITE_AGENT_OS_API= npm run build",
    "dev": "AGENT_OS_AGENTS_DIR=./data/agents bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "run": "bun run src/cli.ts run",
    "cli": "bun run src/cli.ts",
    "sulala": "bun run src/cli.ts",
    "setup": "mkdir -p ~/.agent-os/agents && cp examples/echo-agent.json ~/.agent-os/agents/",
    "seed:memory": "bun run scripts/seed-fake-memory.ts",
    "prepublishOnly": "bun run build && (cd dashboard && npm install && VITE_AGENT_OS_API= npm run build) && node -e \"require('fs').cpSync('dashboard/dist','dashboard-dist',{recursive:true})\""
  },
  "files": [
    "README.md",
    "docs",
    "dist",
    "dashboard-dist",
    "data/agents",
    "data/skills",
    "data/templates"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "keywords": [
    "ai",
    "agents",
    "automation",
    "bun",
    "local"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "latest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "node-cron": "^4.2.1",
    "react-force-graph-2d": "^1.25.2",
    "tweetnacl": "^1.0.3",
    "yaml": "^2.8.2",
    "zod": "3"
  }
}
